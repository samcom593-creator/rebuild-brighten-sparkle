{
  "name": "rebuild-brighten-sparkle (Codespaces autosave)",
  "image": "mcr.microsoft.com/devcontainers/universal:2-linux",
  "features": {
    "ghcr.io/devcontainers/features/node:1": { "version": "lts" },
    "ghcr.io/devcontainers/features/github-cli:1": {},
    "ghcr.io/devcontainers/features/git:1": {}
  },
  "forwardPorts": [3000, 5173, 8080, 8000, 4173],
  "portsAttributes": {
    "3000": { "label": "app", "onAutoForward": "openPreview" },
    "5173": { "label": "vite", "onAutoForward": "openPreview" },
    "8080": { "label": "preview", "onAutoForward": "silent" }
  },
  "containerEnv": {
    "AUTOSAVE_ENABLED": "1",
    "AUTOSAVE_INTERVAL_SECONDS": "7200",
    "AUTOSAVE_DEBOUNCE_SECONDS": "20",
    "AUTOSAVE_BRANCH_PREFIX": "autosave",
    "AUTOSAVE_REMOTE": "origin",
    "AUTOSAVE_PROTECTED_BRANCHES": "main,master,production,release",
    "AUTOSAVE_MAX_FILE_MB": "25",
    "AUTOSAVE_LOG": "/tmp/autosave-daemon.log"
  },
  "customizations": {
    "vscode": {
      "settings": {
        "files.autoSave": "afterDelay",
        "files.autoSaveDelay": 1000,
        "editor.formatOnSave": true,
        "editor.tabSize": 2,
        "editor.rulers": [100],
        "editor.bracketPairColorization.enabled": true,
        "editor.guides.bracketPairs": "active",
        "editor.minimap.enabled": false,
        "files.trimTrailingWhitespace": true,
        "files.insertFinalNewline": true,
        "files.eol": "\n",
        "git.enableSmartCommit": true,
        "git.confirmSync": false,
        "git.autofetch": true,
        "git.postCommitCommand": "push",
        "terminal.integrated.defaultProfile.linux": "bash",
        "terminal.integrated.scrollback": 10000,
        "workbench.editor.enablePreview": false,
        "workbench.startupEditor": "readme",
        "telemetry.telemetryLevel": "off",
        "redhat.telemetry.enabled": false,
        "extensions.ignoreRecommendations": false,
        "task.allowAutomaticTasks": "on"
      },
      "extensions": [
        "esbenp.prettier-vscode",
        "dbaeumer.vscode-eslint",
        "EditorConfig.EditorConfig",
        "GitHub.copilot",
        "GitHub.copilot-chat",
        "GitHub.vscode-pull-request-github",
        "GitHub.vscode-github-actions",
        "eamodio.gitlens",
        "mhutchie.git-graph",
        "supabase.vscode-supabase-extension",
        "Prisma.prisma",
        "bradlc.vscode-tailwindcss",
        "ms-vscode.vscode-typescript-next",
        "yoavbls.pretty-ts-errors",
        "csstools.postcss",
        "formulahendry.auto-rename-tag",
        "naumovs.color-highlight",
        "wayou.vscode-todo-highlight",
        "Gruntfuggly.todo-tree",
        "streetsidesoftware.code-spell-checker",
        "ms-azuretools.vscode-docker",
        "redhat.vscode-yaml",
        "tamasfe.even-better-toml",
        "ms-vscode-remote.remote-containers",
        "anthropic.claude-code",
        "emeraldwalk.RunOnSave"
      ]
    }
  },
  "remoteEnv": {
    "PATH": "${containerEnv:PATH}:/workspaces/${localWorkspaceFolderBasename}/.devcontainer/bin"
  },
  "onCreateCommand": "bash .devcontainer/post-create.sh",
  "postStartCommand": "bash .devcontainer/post-start.sh",
  "postAttachCommand": {
    "tail-autosave": "test -f /tmp/autosave-daemon.log && tail -n 5 /tmp/autosave-daemon.log || echo 'autosave-daemon: pending startup'"
  },
  "waitFor": "postStartCommand",
  "updateContentCommand": "bash .devcontainer/post-create.sh",
  "shutdownAction": "stopCompose",
  "hostRequirements": { "cpus": 2, "memory": "4gb", "storage": "32gb" }
}
