# Public browser configuration (safe to expose; use non-secret public keys only)
VITE_SUPABASE_URL=https://your-staging-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-public-publishable-key
VITE_GA4_MEASUREMENT_ID=
VITE_META_PIXEL_ID=
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=
VITE_HEADHUNTER_URL=
VITE_ENABLE_CRM_BULK_DELETE=false

# Server / Edge Function configuration (never prefix secrets with VITE_)
SUPABASE_URL=https://your-staging-project.supabase.co
SUPABASE_ANON_KEY=your-public-anon-key
SUPABASE_SERVICE_ROLE_KEY=replace-in-secret-manager
SUPABASE_DB_URL=replace-in-secret-manager
RESEND_API_KEY=replace-in-secret-manager
APEX_CONTACT_FROM="APEX Financial <notifications@example.com>"
APEX_CONTACT_DRY_RUN=true
APP_BASE_URL=http://localhost:4174

# Optional integrations — leave blank until the capability is approved
