diff --git a/src/hooks/useLandingLiveStats.ts b/src/hooks/useLandingLiveStats.ts
new file mode 100644
index 00000000..62e14bad
--- /dev/null
+++ b/src/hooks/useLandingLiveStats.ts
@@ -0,0 +1,19 @@
+import { useQuery } from "@tanstack/react-query";
+import { parseLandingLiveStats } from "@/lib/landingLiveStats";
+
+export function useLandingLiveStats(enabled: boolean) {
+  return useQuery({
+    queryKey: ["landing_live_stats"],
+    queryFn: async () => {
+      // Keep the public landing's first paint independent of the database client.
+      const { supabase } = await import("@/integrations/supabase/client");
+      const { data, error } = await supabase.rpc("landing_live_stats");
+      if (error) throw error;
+      return parseLandingLiveStats(data);
+    },
+    enabled,
+    staleTime: 60_000,
+    refetchInterval: 300_000,
+    retry: 1,
+  });
+}
diff --git a/src/hooks/useProducerWorkspace.ts b/src/hooks/useProducerWorkspace.ts
new file mode 100644
index 00000000..95cb6eec
--- /dev/null
+++ b/src/hooks/useProducerWorkspace.ts
@@ -0,0 +1,24 @@
+import { useQuery } from "@tanstack/react-query";
+import { useBusinessToday } from "@/hooks/useBusinessToday";
+import { useAuth } from "@/hooks/useAuth";
+import { useProductionRealtime } from "@/hooks/useProductionRealtime";
+import { looseSupabase } from "@/lib/looseSupabase";
+import { producerWorkspaceSchema } from "@/lib/producerWorkspace";
+
+export function useProducerWorkspace(agentId?: string | null, enabled = true) {
+  const today = useBusinessToday();
+  const { user } = useAuth();
+  const query = useQuery({
+    queryKey: ["producer-workspace", agentId, user?.id, today], enabled: Boolean(agentId && user?.id) && enabled,
+    staleTime: 120_000, retry: 1,
+    queryFn: async () => {
+      const { data, error } = await looseSupabase.rpc("producer_month_workspace", { p_agent_id: agentId });
+      if (error) throw error;
+      const workspace = producerWorkspaceSchema.parse(data);
+      if (workspace.agent_id !== agentId) throw new Error("Personal production could not be verified for this producer.");
+      return workspace;
+    },
+  });
+  useProductionRealtime(() => { if (agentId && user?.id && enabled) void query.refetch({ cancelRefetch: false }); }, 800);
+  return query;
+}
