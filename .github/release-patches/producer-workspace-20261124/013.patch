diff --git a/supabase/migrations/20261124111000_lead_pipeline_identity_guard.sql b/supabase/migrations/20261124111000_lead_pipeline_identity_guard.sql
new file mode 100644
index 00000000..a7543540
--- /dev/null
+++ b/supabase/migrations/20261124111000_lead_pipeline_identity_guard.sql
@@ -0,0 +1,69 @@
+-- A lead's own source record is authoritative for contact enrichment. A shared
+-- phone alone never selects a household member's DOB/address or pipeline record.
+begin;
+create or replace function public.my_lead_to_pipeline(p_item uuid)
+returns jsonb language plpgsql security definer set search_path to 'public' set row_security to 'off' as $$
+declare v record; v_agent uuid; v_client uuid; v_addr text; v_city text; v_zip text; v_dob date;
+  v_phone_count int; v_identity_count int;
+begin
+  if auth.uid() is null then raise exception 'Authentication required' using errcode='42501'; end if;
+  select i.id,i.bundle_id,i.lead_id,i.source_kind,i.attrs,i.phone10,i.first_name,i.last_name,i.email,i.state,i.status,i.quality_tier,b.name as bundle_name
+    into v from public.lead_bundle_items i join public.lead_bundles b on b.id=i.bundle_id and b.archived_at is null
+   where i.id=p_item and i.removed_at is null;
+  if v.id is null then raise exception 'That lead is no longer in a live bundle.' using errcode='22023'; end if;
+  if not exists(select 1 from public.lead_bundle_grants g where g.bundle_id=v.bundle_id and g.user_id=auth.uid() and g.revoked_at is null) then
+    raise exception 'This lead is not assigned to you.' using errcode='42501';
+  end if;
+  if v.phone10 is null or v.phone10 !~ '^[0-9]{10}$' then raise exception 'This lead has no usable phone number.' using errcode='22023'; end if;
+  -- Same lock as suppression/assignment: a concurrent opt-out cannot be missed.
+  perform pg_advisory_xact_lock(hashtextextended(v.phone10,951));
+  if v.status='do_not_call' or exists(select 1 from public.lead_contact_dnc d where d.phone10=v.phone10 or d.phone10=v.attrs->>'replaced_phone10')
+    or exists(select 1 from public.mat_lead_pool m where m.phone10=v.phone10 and
+      (coalesce((m.flags->>'true_dnc')::boolean,m.dnc) or m.flags @> '{"current_client":true}' or m.flags @> '{"import_review_required":true}')) then
+    raise exception 'This lead is held from contact or needs review. Ask the lead administrator to review its hold reason.' using errcode='23514';
+  end if;
+  v_agent := public.get_agent_id(auth.uid());
+  if v_agent is null then raise exception 'No agent record is linked to this login. An admin can link it on the agent profile, then retry.'; end if;
+  perform pg_advisory_xact_lock(hashtextextended(v_agent::text || ':' || v.phone10,952));
+
+  if v.source_kind='marketing' and v.lead_id is not null then
+    select cl.street_address,cl.city,cl.zip,cl.dob into v_addr,v_city,v_zip,v_dob
+      from public.client_leads cl where cl.id=v.lead_id;
+  else
+    select l.address,l.city,l.zip into v_addr,v_city,v_zip from public.readymode_leads l
+     where l.phone10=v.phone10 and nullif(btrim(v.first_name),'') is not null and nullif(btrim(v.last_name),'') is not null
+       and lower(btrim(l.first_name))=lower(btrim(v.first_name)) and lower(btrim(l.last_name))=lower(btrim(v.last_name))
+     order by l.rm_lead_id desc limit 1;
+  end if;
+
+  select count(*)::int,count(*) filter(where nullif(btrim(v.first_name),'') is not null and nullif(btrim(v.last_name),'') is not null
+       and lower(btrim(c.first_name))=lower(btrim(v.first_name)) and lower(btrim(c.last_name))=lower(btrim(v.last_name))
+       and (v_dob is null or c.date_of_birth is null or c.date_of_birth=v_dob))::int
+    into v_phone_count,v_identity_count from public.agentlink_clients c where c.agent_id=v_agent
+      and right(regexp_replace(coalesce(c.phone,''),'[^0-9]','','g'),10)=v.phone10;
+  if v_identity_count=1 then
+    select c.id into v_client from public.agentlink_clients c where c.agent_id=v_agent
+      and right(regexp_replace(coalesce(c.phone,''),'[^0-9]','','g'),10)=v.phone10
+      and lower(btrim(c.first_name))=lower(btrim(v.first_name)) and lower(btrim(c.last_name))=lower(btrim(v.last_name))
+      and (v_dob is null or c.date_of_birth is null or c.date_of_birth=v_dob);
+    return jsonb_build_object('client_id',v_client,'created',false);
+  elsif v_phone_count>0 then
+    raise exception 'This phone matches a different or ambiguous client identity. A lead administrator must review the household match.' using errcode='23514';
+  end if;
+
+  insert into public.agentlink_clients(agent_id,first_name,last_name,phone,email,street_address,city,state,zip_code,date_of_birth,
+    communication_notes,pipeline_stage,external_source,created_at,updated_at)
+  values(v_agent,left(coalesce(nullif(btrim(v.first_name),''),'Lead'),120),left(coalesce(nullif(btrim(v.last_name),''),'(last name not on file)'),120),
+    v.phone10,nullif(left(btrim(coalesce(v.email,'')),254),''),nullif(left(btrim(coalesce(v_addr,'')),200),''),
+    nullif(left(btrim(coalesce(v_city,'')),100),''),case when btrim(coalesce(v.state,'')) ~ '^[A-Za-z]{2}$' then upper(btrim(v.state)) end,
+    nullif(left(btrim(coalesce(v_zip,'')),10),''),v_dob,'From My Leads: ' || v.bundle_name,'NEW_INITIAL','apex',now(),now()) returning id into v_client;
+  insert into public.client_pipeline_activity(client_id,activity_type,body,created_by)
+    values(v_client,'client_created','Added from My Leads (' || v.bundle_name || ')',auth.uid());
+  insert into public.lead_bundle_events(bundle_id,item_id,user_id,actor,action,detail)
+    values(v.bundle_id,p_item,auth.uid(),auth.uid(),'to_pipeline',jsonb_build_object('client_id',v_client,'lead_id',v.lead_id));
+  return jsonb_build_object('client_id',v_client,'created',true);
+end $$;
+revoke all on function public.my_lead_to_pipeline(uuid) from public,anon;
+grant execute on function public.my_lead_to_pipeline(uuid) to authenticated;
+notify pgrst,'reload schema';
+commit;
diff --git a/supabase/migrations/20261124120000_producer_workspace.sql b/supabase/migrations/20261124120000_producer_workspace.sql
new file mode 100644
index 00000000..3b3e02b1
--- /dev/null
+++ b/supabase/migrations/20261124120000_producer_workspace.sql
@@ -0,0 +1,175 @@
+-- Producer workspace: personal monthly production, an evidenced activity plan, and
+-- effective-dated selling schedules. No provider calls, sends, or seeded fake activity.
+-- Canonical production uses Phoenix posted_date, matching v_production_canonical.
+
+create or replace function public.producer_can_access_agent(p_agent_id uuid)
+returns boolean language sql stable security definer set search_path to 'public' as $$
+  select auth.uid() is not null
+    and not public.fn_user_login_blocked(auth.uid())
+    and not public.fn_user_is_suspended(auth.uid())
+    and (
+      public.apex_is_admin()
+      or exists (
+        select 1 from public.agents a
+         where coalesce(a.canonical_agent_id, a.id) = p_agent_id
+           and a.user_id = auth.uid()
+           and a.is_deactivated is not true and a.is_inactive is not true
+           and coalesce(a.status,'') not in ('terminated','inactive')
+           and not public.fn_agent_is_suspended(p_agent_id)
+      )
+    )
+$$;
+revoke all on function public.producer_can_access_agent(uuid) from public, anon;
+grant execute on function public.producer_can_access_agent(uuid) to authenticated;
+
+create table if not exists public.producer_work_schedules (
+  agent_id uuid not null references public.agents(id) on delete cascade,
+  effective_on date not null,
+  selling_days integer[] not null,
+  created_by uuid not null references auth.users(id),
+  created_at timestamptz not null default now(),
+  primary key (agent_id, effective_on),
+  constraint producer_work_days_valid check (
+    cardinality(selling_days) between 1 and 7
+    and selling_days <@ array[0,1,2,3,4,5,6]
+    and array_position(selling_days, null) is null
+  )
+);
+alter table public.producer_work_schedules enable row level security;
+create policy producer_work_schedules_read on public.producer_work_schedules
+  for select to authenticated using (public.producer_can_access_agent(agent_id));
+revoke all on public.producer_work_schedules from public, anon, authenticated;
+grant select on public.producer_work_schedules to authenticated;
+
+create or replace function public.producer_set_work_schedule(p_agent_id uuid, p_selling_days integer[])
+returns jsonb language plpgsql security definer set search_path to 'public' as $$
+declare v_days integer[]; v_effective date := (now() at time zone 'America/Phoenix')::date + 1;
+begin
+  if not public.producer_can_access_agent(p_agent_id) then
+    raise exception 'Producer not found or access denied' using errcode = '42501';
+  end if;
+  select array_agg(distinct d order by d) into v_days from unnest(p_selling_days) d;
+  if v_days is null or cardinality(v_days) not between 1 and 7
+     or not (v_days <@ array[0,1,2,3,4,5,6]) or array_position(v_days, null) is not null then
+    raise exception 'Choose at least one selling day' using errcode = '22023';
+  end if;
+  -- Tomorrow is the earliest effective date. A schedule change never rewrites a
+  -- completed day or repairs a missed streak retroactively.
+  insert into public.producer_work_schedules(agent_id, effective_on, selling_days, created_by)
+  values (p_agent_id, v_effective, v_days, auth.uid())
+  on conflict (agent_id, effective_on) do update
+    set selling_days = excluded.selling_days, created_by = excluded.created_by, created_at = now();
+  return jsonb_build_object('effective_on', v_effective, 'selling_days', v_days);
+end $$;
+revoke all on function public.producer_set_work_schedule(uuid, integer[]) from public, anon;
+grant execute on function public.producer_set_work_schedule(uuid, integer[]) to authenticated;
+
+create or replace function public.producer_month_workspace(p_agent_id uuid)
+returns jsonb language plpgsql stable security definer set search_path to 'public' as $$
+declare
+  v_today date := (now() at time zone 'America/Phoenix')::date;
+  v_start date; v_end date; v_goal numeric := 20000; v_goal_source text := 'agency_standard';
+  v_result jsonb;
+begin
+  if not public.producer_can_access_agent(p_agent_id) then
+    raise exception 'Producer not found or access denied' using errcode = '42501';
+  end if;
+  v_start := date_trunc('month', v_today)::date;
+  v_end := (v_start + interval '1 month - 1 day')::date;
+  select greatest(20000, g.personal_ap_goal), 'assigned_personal_goal'
+    into v_goal, v_goal_source
+    from public.team_goals g
+   where g.agent_id = p_agent_id and g.period_start = v_start and g.period_end = v_end
+     and g.personal_ap_goal > 0 limit 1;
+  v_goal := coalesce(v_goal, 20000);
+  v_goal_source := coalesce(v_goal_source, 'agency_standard');
+
+  with production as materialized (
+    select p.* from public.v_production_canonical p
+      join public.agents pa on pa.id = p.agent_id
+     where coalesce(pa.canonical_agent_id,pa.id) = p_agent_id and p.posted_date between v_today - 179 and v_today
+  ), day_plan as (
+    select d::date as day,
+      extract(dow from d)::integer = any(coalesce((
+        select s.selling_days from public.producer_work_schedules s
+         where s.agent_id = p_agent_id and s.effective_on <= d::date
+         order by s.effective_on desc limit 1
+      ), array[1,2,3,4,5])) as scheduled
+      from generate_series((v_today - 179)::timestamp, v_end::timestamp, interval '1 day') d
+  ), production_days as (
+    select posted_date as day, sum(annual_premium) as ap, count(*) as deals
+      from production where annual_premium > 0 group by posted_date
+  ), activity_events as materialized (
+    -- Provider receipts only. Multiple imports of one provider event count once.
+    select distinct on (coalesce(nullif(c.external_call_id, ''), c.id::text))
+      coalesce(nullif(c.external_call_id, ''), c.id::text) as event_key,
+      (c.call_started_at at time zone 'America/Phoenix')::date as day,
+      c.disposition
+      from public.readymode_dialer_calls c
+      join public.agents a on a.id = c.agent_id
+     where coalesce(a.canonical_agent_id, a.id) = p_agent_id
+       and c.call_started_at >= ((v_today - 60)::timestamp at time zone 'America/Phoenix')
+       and c.call_started_at < ((v_today + 1)::timestamp at time zone 'America/Phoenix')
+       and c.call_ended_at is not null and c.duration_seconds > 0
+       and nullif(btrim(c.disposition), '') is not null
+     order by coalesce(nullif(c.external_call_id, ''), c.id::text), c.updated_at desc
+  ), activity as (
+    select count(*) filter (where day < v_today) as sample_calls,
+      count(*) filter (where day < v_today and disposition = 'Completed Sale') as sample_sold_calls,
+      count(*) filter (where day = v_today) as completed_today,
+      count(*) filter (where day = v_today and disposition = 'Completed Sale') as sold_calls_today
+      from activity_events
+  ), policy_baseline as (
+    select count(*) as sample_policies, avg(annual_premium) as avg_policy_ap
+      from production where posted_date >= v_today - 60 and posted_date < v_today and annual_premium > 0
+  ), monthly as (
+    select coalesce(sum(annual_premium),0) as ap, count(*) as deals,
+      max(synced_at) as source_updated_at
+      from production where posted_date >= v_start and annual_premium > 0
+  ), month_schedule as (
+    select count(*) filter (where scheduled and day >= v_start) as total_days,
+      count(*) filter (where scheduled and day between v_start and v_today) as elapsed_days,
+      count(*) filter (where scheduled and day >= v_today) as remaining_days
+      from day_plan
+  ), carrier as (
+    -- These are carrier-book subsets, never invented payment/retention evidence.
+    select count(*) as known_policies,
+      coalesce(sum(p.annual_premium) filter (
+        where p.status_bucket = 'active' and p.sold_on between v_start and v_today
+      ),0) as in_force_month_ap,
+      count(*) filter (
+        where p.status_bucket = 'active' and p.last_seen_on is not null
+          and p.effective_on <= least(v_today,p.last_seen_on) - 90
+      ) as active_90d_policies,
+      max(p.updated_at) as updated_at,
+      min(p.last_seen_on) as oldest_seen_on
+      from public.carrier_book_policies p
+      join public.agents a on a.id = p.agent_id
+     where coalesce(a.canonical_agent_id, a.id) = p_agent_id
+  )
+  select jsonb_build_object(
+    'agent_id', p_agent_id, 'today', v_today, 'period_start', v_start, 'period_end', v_end,
+    'as_of', now(), 'timezone', 'America/Phoenix', 'target_ap', v_goal, 'target_source', v_goal_source,
+    'production_ap', m.ap, 'production_deals', m.deals, 'production_updated_at', m.source_updated_at,
+    'selling_days_total', s.total_days, 'selling_days_elapsed', s.elapsed_days, 'selling_days_remaining', s.remaining_days,
+    'schedule', coalesce((select selling_days from public.producer_work_schedules where agent_id = p_agent_id and effective_on <= v_today order by effective_on desc limit 1), array[1,2,3,4,5]),
+    'next_schedule', (select jsonb_build_object('effective_on', effective_on, 'selling_days', selling_days) from public.producer_work_schedules where agent_id = p_agent_id and effective_on > v_today order by effective_on limit 1),
+    'activity', jsonb_build_object('sample_days', 60, 'sample_calls', a.sample_calls,
+      'sample_sold_calls', a.sample_sold_calls, 'sample_policies', b.sample_policies,
+      'avg_policy_ap', b.avg_policy_ap, 'completed_today', a.completed_today, 'sold_calls_today', a.sold_calls_today),
+    'carrier', jsonb_build_object('covered_policies', c.known_policies,
+      'in_force_month_ap', case when c.known_policies > 0 then c.in_force_month_ap end,
+      'active_90d_policies', case when c.known_policies > 0 then c.active_90d_policies end,
+      'updated_at', c.updated_at, 'oldest_seen_on', c.oldest_seen_on,
+      'paid_ap', null, 'paid_reason', 'No verified payment receipt is supplied by this view'),
+    'days', (select coalesce(jsonb_agg(jsonb_build_object(
+      'day', d.day, 'scheduled', d.scheduled, 'production_ap', coalesce(p.ap,0), 'deals', coalesce(p.deals,0)
+    ) order by d.day), '[]'::jsonb) from day_plan d left join production_days p on p.day = d.day where d.day <= v_today)
+  ) into v_result from monthly m cross join month_schedule s cross join activity a cross join policy_baseline b cross join carrier c;
+  return v_result;
+end $$;
+revoke all on function public.producer_month_workspace(uuid) from public, anon;
+grant execute on function public.producer_month_workspace(uuid) to authenticated;
+
+comment on function public.producer_month_workspace(uuid) is
+  'Personal canonical production only; team sales and ReadyMode sale dispositions never add to ALP. Carrier in-force and 90-day-active counts are explicitly partial carrier-book evidence, not payment receipts. Workday production streak inputs include rest days and retain historical schedules.';
diff --git a/supabase/migrations/20261124121000_producer_client_calls.sql b/supabase/migrations/20261124121000_producer_client_calls.sql
new file mode 100644
index 00000000..4b62984c
--- /dev/null
+++ b/supabase/migrations/20261124121000_producer_client_calls.sql
@@ -0,0 +1,193 @@
+-- Client-owned call history. Reuse ReadyMode receipts and call_transcripts;
+-- annotations add identity/category, not another copy of a provider recording.
+-- Raw provider audio/text retains can_view_sold_calls(). No AI invocation.
+
+create or replace function public.producer_can_access_client(p_client_id uuid)
+returns boolean language sql stable security definer set search_path to 'public' as $$
+  select exists (
+    select 1 from public.agentlink_clients c join public.agents a on a.id = c.agent_id
+     where c.id = p_client_id and public.producer_can_access_agent(coalesce(a.canonical_agent_id, a.id))
+  )
+$$;
+revoke all on function public.producer_can_access_client(uuid) from public, anon;
+grant execute on function public.producer_can_access_client(uuid) to authenticated;
+
+create table if not exists public.producer_client_call_links (
+  id uuid primary key default gen_random_uuid(),
+  client_id uuid not null references public.agentlink_clients(id) on delete cascade,
+  provider_call_id uuid unique references public.readymode_dialer_calls(id) on delete cascade,
+  transcript_id uuid unique references public.call_transcripts(id) on delete cascade,
+  category text not null default 'uncategorized',
+  created_by uuid not null references auth.users(id),
+  created_at timestamptz not null default now(),
+  updated_at timestamptz not null default now(),
+  constraint producer_call_one_source check (num_nonnulls(provider_call_id, transcript_id) = 1),
+  constraint producer_call_category check (category in ('uncategorized','discovery','presentation','objection','follow_up','sale','service'))
+);
+create index if not exists producer_client_call_links_client_idx on public.producer_client_call_links(client_id);
+alter table public.producer_client_call_links enable row level security;
+create policy producer_client_call_links_read on public.producer_client_call_links
+  for select to authenticated using (public.producer_can_access_client(client_id));
+revoke all on public.producer_client_call_links from public, anon, authenticated;
+grant select on public.producer_client_call_links to authenticated;
+
+-- Existing manager-wide transcript policies remain valid for recruiting history,
+-- but cannot expose newly client-linked transcripts belonging to another producer.
+create or replace function public.producer_transcript_allowed(p_transcript_id uuid)
+returns boolean language sql stable security definer set search_path to 'public' as $$
+  select not exists (select 1 from public.producer_client_call_links l where l.transcript_id = p_transcript_id)
+    or exists (select 1 from public.producer_client_call_links l
+                where l.transcript_id = p_transcript_id and public.producer_can_access_client(l.client_id))
+$$;
+revoke all on function public.producer_transcript_allowed(uuid) from public, anon;
+grant execute on function public.producer_transcript_allowed(uuid) to authenticated;
+create policy producer_client_transcript_scope on public.call_transcripts
+  as restrictive for all to authenticated
+  using (public.producer_transcript_allowed(id))
+  with check (public.producer_transcript_allowed(id));
+
+create or replace function public.producer_call_matches_client(p_client_id uuid, p_call_id uuid)
+returns boolean language sql stable security definer set search_path to 'public' as $$
+  select public.producer_can_access_client(p_client_id) and exists (
+    select 1 from public.agentlink_clients c
+      join public.agents ca on ca.id = c.agent_id
+      join public.readymode_dialer_calls r on r.id = p_call_id
+      join public.agents ra on ra.id = r.agent_id
+     where c.id = p_client_id
+       and coalesce(ca.canonical_agent_id, ca.id) = coalesce(ra.canonical_agent_id, ra.id)
+       and (
+         exists (select 1 from public.producer_client_call_links l where l.provider_call_id = r.id and l.client_id = c.id)
+         or (
+           not exists (select 1 from public.producer_client_call_links l where l.provider_call_id = r.id)
+           and length(regexp_replace(coalesce(c.phone,''), '[^0-9]', '', 'g')) >= 10
+           and r.lead_phone10 = right(regexp_replace(c.phone, '[^0-9]', '', 'g'),10)
+           -- Shared household numbers never silently attach the call to one person.
+           and (select count(*) from public.agentlink_clients other
+                  join public.agents oa on oa.id = other.agent_id
+                 where coalesce(oa.canonical_agent_id, oa.id) = coalesce(ca.canonical_agent_id, ca.id)
+                   and right(regexp_replace(coalesce(other.phone,''), '[^0-9]', '', 'g'),10) = r.lead_phone10) = 1
+         )
+       )
+  )
+$$;
+revoke all on function public.producer_call_matches_client(uuid,uuid) from public, anon;
+grant execute on function public.producer_call_matches_client(uuid,uuid) to authenticated;
+
+create or replace function public.producer_client_calls(
+  p_client_id uuid, p_category text default null,
+  p_before_at timestamptz default null, p_before_key text default null
+)
+returns jsonb language plpgsql stable security definer set search_path to 'public' as $$
+declare v_raw boolean := public.can_view_sold_calls(); v jsonb; v_agent uuid; v_phone text; v_unique boolean;
+begin
+  if not public.producer_can_access_client(p_client_id) then
+    raise exception 'Client not found or access denied' using errcode = '42501';
+  end if;
+  if (p_before_at is null) <> (p_before_key is null) then raise exception 'Incomplete page cursor' using errcode = '22023'; end if;
+  if p_category is not null and p_category not in ('uncategorized','discovery','presentation','objection','follow_up','sale','service') then
+    raise exception 'Unknown call category' using errcode = '22023';
+  end if;
+  select coalesce(a.canonical_agent_id,a.id), right(regexp_replace(coalesce(c.phone,''),'[^0-9]','','g'),10)
+    into v_agent, v_phone from public.agentlink_clients c join public.agents a on a.id = c.agent_id where c.id = p_client_id;
+  select count(*) = 1 into v_unique from public.agentlink_clients c join public.agents a on a.id = c.agent_id
+   where coalesce(a.canonical_agent_id,a.id) = v_agent
+     and right(regexp_replace(coalesce(c.phone,''),'[^0-9]','','g'),10) = v_phone;
+
+  with records as (
+    select 'readymode:' || r.id::text as key, r.id as source_id, 'readymode'::text as source,
+      coalesce(r.call_started_at,r.imported_at) as happened_at,
+      coalesce(l.category, case
+        when r.disposition = 'Completed Sale' then 'sale'
+        when r.disposition in ('Bank Objection','No Bank Account','Social Objection') then 'objection'
+        when r.disposition = '&rArr; Appointments' then 'follow_up' else 'uncategorized' end) as category,
+      r.disposition as outcome, r.duration_seconds,
+      case when v_raw then t.raw_text else null end as transcript,
+      case when v_raw then r.recording_url else null end as audio_url,
+      case when not v_raw then 'restricted' when t.raw_text is null then 'not_available' else 'available' end as transcript_access
+      from public.readymode_dialer_calls r
+      join public.agents a on a.id = r.agent_id
+      left join public.producer_client_call_links l on l.provider_call_id = r.id
+      left join lateral (select x.raw_text from public.readymode_call_transcripts x where x.call_id = r.id order by x.transcribed_at desc limit 1) t on v_raw
+     where coalesce(a.canonical_agent_id,a.id) = v_agent
+       and (l.client_id = p_client_id or (l.id is null and v_unique and length(v_phone) = 10 and r.lead_phone10 = v_phone))
+    union all
+    select 'manual:' || t.id::text, t.id, 'manual', t.created_at, l.category,
+      t.call_outcome, t.duration_seconds, t.transcript, null::text,
+      case when t.transcript is null then 'not_available' else 'available' end
+      from public.producer_client_call_links l join public.call_transcripts t on t.id = l.transcript_id
+     where l.client_id = p_client_id
+  ), page as materialized (
+    select * from records r
+     where (p_category is null or r.category = p_category)
+       and (p_before_at is null or (r.happened_at,r.key) < (p_before_at,p_before_key))
+     order by r.happened_at desc,r.key desc limit 26
+  ), shown as (select * from page order by happened_at desc,key desc limit 25)
+  select jsonb_build_object(
+    'client_id', p_client_id, 'raw_provider_access', v_raw,
+    'ambiguous_phone', length(v_phone) = 10 and not v_unique,
+    'calls', coalesce((select jsonb_agg(to_jsonb(s) order by happened_at desc,key desc) from shown s),'[]'::jsonb),
+    'next_cursor', case when (select count(*) from page) > 25 then
+      (select jsonb_build_object('at',happened_at,'key',key) from shown order by happened_at,key limit 1) else null end
+  ) into v;
+  return v;
+end $$;
