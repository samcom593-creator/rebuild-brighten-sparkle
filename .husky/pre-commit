#!/usr/bin/env bash
# wave-28 (2026-06-07): pre-commit guard for VSL videoId sync invariant.
# wave-29 (2026-06-08): extended to also gate check:metric-truth,
#                       check:sync-reliability, check:unsafe-supabase-catch,
#                       and check:forbidden-language behind staged-file filters.
#
# Activated via `git config core.hooksPath .husky` (set by `npm run prepare`).
# No husky dependency required — we use git's built-in hooksPath.
#
# Why pre-commit instead of just relying on the Vite plugin / CI:
#   The wave-27 cross-session race (commits e24adf69 -> 2ec9b695 -> 2b21d6df)
#   proved the Vite plugin only catches drift AFTER the bad commit is pushed
#   to Vercel. Same wave-25-class drift window exists for the other 4 checks
#   today — they only fail at `npm run verify:core` (CI), never at commit
#   time. Pre-commit closes that window on Sam's laptop before push.
#
# Fast-fail: each check only runs when files that could affect its rules are
# staged. Saves ~2s on unrelated commits; full sweep ~2s when all fire.
set -e

STAGED=$(git diff --cached --name-only --diff-filter=ACMR)

# Helper: returns 0 if any staged file matches the given regex
match() {
  echo "$STAGED" | grep -qE "$1"
}

# ---------- check-vsl-sync (wave-28) ----------
# Trigger: index.html / HeroSection.tsx / the script itself / vite.config.ts
if match '^(index\.html|src/components/landing/HeroSection\.tsx|scripts/check-vsl-sync\.mjs|vite\.config\.ts)$'; then
  echo "[pre-commit] VSL-affecting file staged — running check:vsl-sync…"
  node scripts/check-vsl-sync.mjs
fi

# ---------- check-metric-truth (wave-29) ----------
# Trigger: any src/ tsx|ts|jsx|js, supabase/functions/ or supabase/migrations/,
# api/ ts|tsx|js|mjs, or the script itself.
if match '^(src/.*\.(tsx?|jsx?)$|supabase/(functions|migrations)/|api/.*\.(tsx?|jsx?|mjs)$|scripts/check-metric-truth\.mjs$)'; then
  echo "[pre-commit] Metric-truth-affecting file staged — running check:metric-truth…"
  node scripts/check-metric-truth.mjs
fi

# ---------- check-sync-reliability (wave-29) ----------
# Trigger: deploy/cron workflows, edge functions, migrations, dashboard
# pages/components, the InsuraCloud sync API route, or the script itself.
if match '^(\.github/workflows/(deploy-supabase|external-cron-backup)\.yml$|supabase/(functions|migrations)/|src/pages/|src/components/dashboard/|api/sync-insuracloud\.ts$|scripts/check-sync-reliability\.mjs$)'; then
  echo "[pre-commit] Sync-reliability-affecting file staged — running check:sync-reliability…"
  node scripts/check-sync-reliability.mjs
fi

# ---------- check-unsafe-supabase-catch (wave-29) ----------
# Trigger: any edge function ts/tsx or the script itself.
if match '^(supabase/functions/.*\.(ts|tsx)$|scripts/check-unsafe-supabase-catch\.mjs$)'; then
  echo "[pre-commit] Edge-function file staged — running check:unsafe-supabase-catch…"
  node scripts/check-unsafe-supabase-catch.mjs
fi

# ---------- check-forbidden-language (wave-29) ----------
# Trigger: any user-facing text file. Script walks whole repo, so any new copy
# anywhere should be scanned. ~1s when fired.
if match '\.(tsx?|jsx?|md|html)$'; then
  echo "[pre-commit] Copy-affecting file staged — running check:forbidden-language…"
  node scripts/check-forbidden-language.mjs
fi

# ---------- check-cold-landing-sonner (wave-37) ----------
# Trigger: any src/ tsx|ts|jsx|js change, the lazyToast wrapper, or the script
# itself. The script walks the cold-landing static-import graph (~22 files
# today), so any new edge into sonner from a landing-reachable file fails
# the commit. Cost: <300ms when fired. Why this matters: sonner is grouped
# into vendor-ui by vite.config.ts advancedChunks, and vendor-ui statically
# imports vendor-radix — so one static `from "sonner"` in any cold-landing
# file drags 22 KB gz vendor-ui + 47 KB gz vendor-radix onto every visitor's
# first paint (Lighthouse: heaviest-transfers list, wave-32+ surfaces this).
if match '^(src/.*\.(tsx?|jsx?)$|scripts/check-cold-landing-sonner\.mjs$)'; then
  echo "[pre-commit] Cold-landing-reachable file staged — running check:cold-landing-sonner…"
  node scripts/check-cold-landing-sonner.mjs
fi

# ---------- check-cold-landing-supabase-queryFn (wave-44) ----------
# Trigger: any src/ tsx|ts change. Walks cold-landing static-import graph and
# fails on any reachable file that calls useQuery+supabase-dynamic-import
# without useInteractionGate. Why this matters: even after wave-42 killed all
# static cold-landing supabase edges, queryFn-on-mount still pulled
# vendor-supabase (45 KB gz) into Lighthouse's cold-landing transfer log via
# dynamic import resolved during the audit window. Wave-43 fixed CTASection +
# CareerPathwaySection; this guard prevents the next eager landing component
# from re-opening the leak. Opt-out marker: `cold-landing-supabase-queryFn-allow`.
if match '^(src/.*\.(tsx?|jsx?)$|scripts/check-cold-landing-supabase-queryFn\.mjs$)'; then
  echo "[pre-commit] Cold-landing-reachable file staged — running check:cold-landing-supabase-queryFn…"
  node scripts/check-cold-landing-supabase-queryFn.mjs
fi

# ---------- check-vendor-icons-landing-census (wave-47) ----------
# Trigger: any landing-reachable src/components/landing/ or src/pages/Index.tsx
# tsx|ts change, the App-level SupabaseHealthBanner, vite.config.ts, or the
# script itself. Parses every lucide-react import name from the hardcoded
# landing-reachable file list and asserts each one is present in the
# vendor-icons-landing chunk-group regex in vite.config.ts. Why this matters:
# wave-22 split lucide into landing-eager subset (17 icons) vs vendor-icons
# (~150 app icons), but for 4 months the subset went stale — new landing
# imports outside the 17 silently pulled the full 47KB raw vendor-icons blob
# during Lighthouse's audit window via the lazy-Suspense children fire. Wave-
# 46 expanded the regex to 48 icons covering every current landing import.
# Without this guard the same drift class re-opens the next time a landing
# component imports a new icon — vendor-icons reappears on the heaviest-
# transfers list, perf score drops 1-3 points, nobody notices for weeks.
# Opt-out marker per file: `vendor-icons-landing-census-allow:<kebab-name>`.
if match '^(src/(pages/Index|components/(landing/.+|SupabaseHealthBanner))\.tsx?$|vite\.config\.ts$|scripts/check-vendor-icons-landing-census\.mjs$)'; then
  echo "[pre-commit] Landing-icon-affecting file staged — running check:vendor-icons-landing-census…"
  node scripts/check-vendor-icons-landing-census.mjs
fi

# ---------- check-landing-css-size (wave-54a) ----------
